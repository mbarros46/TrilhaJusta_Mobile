# Backend Java API
# Use localhost se o Java está rodando na mesma máquina
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Se testar no Android Emulator, descomente a linha abaixo:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Se testar no celular físico, use o IP da sua máquina na rede:
# EXPO_PUBLIC_API_URL=http://172.20.10.3:8080/api/v1

# Configurações opcionais
EXPO_PUBLIC_DEFAULT_USER_ID=1
EXPO_ENABLE_DEV_AUTH=true