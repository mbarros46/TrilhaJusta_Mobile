# URL base da API Java TrilhaJusta (incluindo /api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Opcional: token JWT estático para testes manuais (não obrigatório)
# EXPO_PUBLIC_API_TOKEN=seu_token_jwt_aqui

# Usuário padrão para demonstração (id existente na base Oracle)
EXPO_PUBLIC_DEFAULT_USER_ID=1
